# This is an example file.
#
# The actual local.nix is generated by:
#
#   ./init-local.sh
#
# By default, the actual file is created at:
#
#   ~/.config/dotfiles/local.nix
#
# You can override the path with:
#
#   DOTFILES_LOCAL_NIX=/path/to/local.nix ./init-local.sh
#
# Do not commit the actual local.nix.
# This file is only a template for documentation.

{
  # Your login user name.
  username = "your-username";

  # Host name used as the flake output name.
  #
  # macOS:
  #   darwinConfigurations.<hostname>
  #
  # Linux / WSL:
  #   homeConfigurations.<username>@<hostname>
  hostname = "your-hostname";

  # Allowed values:
  #   "darwin"
  #   "linux"
  platform = "darwin";

  # Allowed combinations:
  #
  # Apple Silicon macOS:
  #   platform = "darwin";
  #   system   = "aarch64-darwin";
  #
  # x86_64 Linux / WSL:
  #   platform = "linux";
  #   system   = "x86_64-linux";
  system = "aarch64-darwin";

  # Examples:
  #   Apple Silicon macOS: "/Users/your-username"
  #   Linux / WSL:         "/home/your-username"
  homeDirectory = "/Users/your-username";

  # WSL only.
  #
  # Use this only when:
  #
  #   platform = "linux";
  #   system   = "x86_64-linux";
  #
  # isWsl = true;

  git = {
    name = "Your Name";
    email = "you@example.com";
  };
}
